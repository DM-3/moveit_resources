<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
    <!-- Xacro imports -->
    <xacro:include filename="panda_arm_hand.urdf.xacro"/>

    <!-- Root link -->
    <link name="world"/>

    <!-- Arms -->
    <xacro:panda_arm_hand enum="1" parent="world">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:panda_arm_hand>
    <xacro:panda_arm_hand enum="2" parent="world">
        <origin xyz="1 0 0" rpy="0 0 0" />
    </xacro:panda_arm_hand>
    <xacro:panda_arm_hand enum="3" parent="world">
        <origin xyz="0 1 0" rpy="0 0 0" />
    </xacro:panda_arm_hand>
</robot>
