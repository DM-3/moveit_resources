<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Create SRDF for one Panda arm and hand -->
    <xacro:macro name="panda_arm_hand" params="enum">

        <!-- srdf for arm -->
        <xacro:include filename="panda_arm.xacro"/>
        <xacro:panda_arm enum="${enum}"/>
        
        <!-- srdf for hand -->
        <xacro:include filename="panda_hand.xacro"/>
        <xacro:panda_hand enum="${enum}"/>

        <!-- group arm and hand -->
        <group name="panda${enum}_arm_hand">
            <group name="panda${enum}_arm" />
            <group name="hand${enum}" />
        </group>

        <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
        <end_effector name="hand${enum}" parent_link="panda${enum}_link8" group="hand${enum}" parent_group="panda${enum}_arm" />

        <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
        <disable_collisions link1="panda${enum}_hand" link2="panda${enum}_link3" reason="Never" />
        <disable_collisions link1="panda${enum}_hand" link2="panda${enum}_link4" reason="Never" />
        <disable_collisions link1="panda${enum}_hand" link2="panda${enum}_link6" reason="Never" />
        <disable_collisions link1="panda${enum}_hand" link2="panda${enum}_link7" reason="Adjacent" />
        <disable_collisions link1="panda${enum}_leftfinger" link2="panda${enum}_link3" reason="Never" />
        <disable_collisions link1="panda${enum}_leftfinger" link2="panda${enum}_link4" reason="Never" />
        <disable_collisions link1="panda${enum}_leftfinger" link2="panda${enum}_link6" reason="Never" />
        <disable_collisions link1="panda${enum}_leftfinger" link2="panda${enum}_link7" reason="Never" />
        <disable_collisions link1="panda${enum}_link3" link2="panda${enum}_rightfinger" reason="Never" />
        <disable_collisions link1="panda${enum}_link4" link2="panda${enum}_rightfinger" reason="Never" />
        <disable_collisions link1="panda${enum}_link6" link2="panda${enum}_rightfinger" reason="Never" />
        <disable_collisions link1="panda${enum}_link7" link2="panda${enum}_rightfinger" reason="Never" />

    </xacro:macro>
</robot>
